  "$id": "https://local.web-design-radar/contracts/stage-result.schema.json",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {"enum": ["ok", "partial"]},
    "browserUsed": {"enum": ["ego-lite", "openclaw-chrome"]},
